-- SCRIPT KHỞI TẠO & KÍCH HOẠT HFK (AN TOÀN - CHỐNG BUG)
-- ==========================================

-- BƯỚC 1: Tạo thư mục
makefolder("HFK")
makefolder("HFK/id check")
makefolder("HFK/id check/id game")
makefolder("HFK/id trùng")

-- BƯỚC 2: Tạo các tệp gốc
writefile("HFK/auto kích hoạt nếu đã có", "")
writefile("HFK/kiểm tra đã có đủ tệp chưa", "")
writefile("HFK/nếu không có id hợp lệ trong folder check id", "")
writefile("HFK/Ok", "")

-- BƯỚC 3: Tạo các tệp con
writefile("HFK/id check/nếu id trùng hoặc không", "")
writefile("HFK/id trùng/code game id", "")

-- BƯỚC 4: Cơ chế chờ (delay) an toàn rồi mới kích hoạt link Trung gian để tránh bug
task.spawn(function()
    -- Chờ 0.5 giây để đảm bảo hệ thống tệp ghi xong hoàn toàn
    task.wait(0.5) 
    
    local okFilePath = "HFK/Ok"
    local trungGianLink = "https://raw.githubusercontent.com/mtheluonge13-droid/Menu-iab-c-a-t/refs/heads/main/Trung%20gian"

    if isfile(okFilePath) then
        print("[HFK System] Khung đã tạo xong, có tệp Ok! Đang gọi Trung gian...")
        pcall(function()
            loadstring(game:HttpGet(trungGianLink))()
        end)
    else
        warn("Lỗi: Không tìm thấy tệp Ok! Hãy kiểm tra lại thư mục HFK.")
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "HFK System",
            Text = "Tìm thằng Minh hỏi! Thiếu tệp Ok kìa.",
            Duration = 5
        })
    end
end)
