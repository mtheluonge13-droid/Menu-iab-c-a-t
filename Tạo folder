-- ==========================================
-- SCRIPT KHỞI TẠO HFK (TỰ ĐỘNG TẠO FOLDER & TỆP CHUẨN XÁC)
-- ==========================================

-- 1. Tạo các cấp thư mục theo đúng phân cấp
makefolder("HFK")
makefolder("HFK/id check")
makefolder("HFK/id check/id game")
makefolder("HFK/id trùng")

-- 2. Hàm hỗ trợ tạo tệp an toàn (nếu chưa có thì mới tạo)
local function createSafeFile(path, content)
    if not isfile(path) then
        writefile(path, content or "")
    end
end

-- 3. Tạo các tệp gốc quan trọng trong thư mục HFK
createSafeFile("HFK/Ok", "")
createSafeFile("HFK/auto kích hoạt nếu đã có", "")
createSafeFile("HFK/kiểm tra đã có đủ tệp chưa", "")
createSafeFile("HFK/nếu không có id hợp lệ trong folder check id", "")

-- 4. Tạo tệp con trong các thư mục check ID
createSafeFile("HFK/id check/nếu id trùng hoặc không", "")
createSafeFile("HFK/id trùng/code game id", "")

-- 5. Chờ một nhịp an toàn rồi gọi tiếp link Trung gian
task.spawn(function()
    task.wait(0.5)
    
    local okFilePath = "HFK/Ok"
    local trungGianLink = "https://raw.githubusercontent.com/mtheluonge13-droid/Menu-iab-c-a-t/refs/heads/main/Trung%20gian"

    if isfile(okFilePath) then
        print("[HFK System] Đã tạo xong khung và tệp Ok! Đang gọi Trung gian...")
        pcall(function()
            loadstring(game:HttpGet(trungGianLink))()
        end)
    else
        warn("[HFK System] Lỗi: Không tìm thấy tệp Ok!")
    end
end)
