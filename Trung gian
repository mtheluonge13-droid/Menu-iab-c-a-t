-- ==========================================

task.wait(0.5)

-- Đường dẫn tệp cần kiểm tra nội dung
local checkTargetFile = "HFK/nếu không có id hợp lệ trong folder check id"
-- Đường dẫn tệp cần kích hoạt tiếp theo nếu tệp trên có code
local nextTriggerFile = "HFK/id check/nếu id trùng hoặc không"
-- Link Raw dự phòng khi tệp trống
local fallbackRawLink = "https://raw.githubusercontent.com/mtheluonge13-droid/Menu-iab-c-a-t/refs/heads/main/Check%20id%20game"

-- Kiểm tra xem tệp check có tồn tại không trước đã
if isfile(checkTargetFile) then
    local fileContent = readfile(checkTargetFile)
    
    -- KIỂM TRA: Nếu tệp TRỐNG (không có chữ / không có code)
    if not fileContent or fileContent == "" or fileContent:match("^%s*$") then
        print("[HFK System] Tệp trống, tiến hành kéo code từ link Raw...")
        
        local success, err = pcall(function()
            loadstring(game:HttpGet(fallbackRawLink))()
        end)
        
        if not success then
            warn("[HFK System] Lỗi khi tải và chạy link Raw: " .. tostring(err))
        end
        
    else
        -- NẾU TỆP ĐÃ CÓ CHỮ / CÓ CODE BÊN TRONG
        print("[HFK System] Tệp đã có nội dung, tiến hành kích hoạt tệp trong thư mục id check...")
        
        local success, err = pcall(function()
            if isfile(nextTriggerFile) then
                local nextContent = readfile(nextTriggerFile)
                if nextContent and nextContent ~= "" then
                    loadstring(nextContent)()
                else
                    warn("[HFK System] Tệp 'nếu id trùng hoặc không' đang bị trống!")
                end
            else
                warn("[HFK System] Không tìm thấy tệp 'nếu id trùng hoặc không' trong folder!")
            end
        end)
        
        if not success then
            warn("[HFK System] Lỗi khi kích hoạt tệp tiếp theo: " .. tostring(err))
        end
    end
else
    warn("[HFK System] Không tìm thấy tệp kiểm tra ban đầu!")
end

