-- ==========================================
-- PHẦN CHECK TỆP "Ok" VÀ KÍCH HOẠT HỆ THỐNG
-- ==========================================

local okFilePath = "HFK/Ok"
local rawCheckIdGame = "https://raw.githubusercontent.com/mtheluonge13-droid/Menu-iab-c-a-t/refs/heads/main/Check%20id%20game"

-- Kiểm tra xem tệp "Ok" có tồn tại hay không
if isfile(okFilePath) then
    print("Đã tìm thấy tệp Ok! Tiến hành các bước tiếp theo...")
    
    -- Kích hoạt ngay code từ link Raw
    pcall(function()
        loadstring(game:HttpGet(rawCheckIdGame))()
    end)
    
else
    -- Nếu không tìm thấy tệp Ok, báo động ngay
    warn("Lỗi: Không tìm thấy tệp Ok! Hãy kiểm tra lại thư mục HFK.")
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "HFK System",
        Text = "Tìm thằng Minh hỏi! Thiếu tệp Ok kìa.",
        Duration = 5
    })
end
