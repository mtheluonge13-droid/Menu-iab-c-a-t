-- ==========================================
-- CODE KIỂM TRA VÀ ĐIỀU PHỐI ID GAME
-- ==========================================

task.wait(0.5)

local currentId = tostring(game.GameId)

-- Các đường dẫn thư mục và tệp
local idGameFolderPath = "HFK/id check/id game"
local idTrungFolderPath = "HFK/id trùng"
local invalidHandlerFile = "HFK/nếu không có id hợp lệ trong folder check id"

-- Đường dẫn tệp kiểm tra trong folder "id game"
local checkFileInIdGame = idGameFolderPath .. "/" .. currentId
-- Đường dẫn tệp thực thi trong folder "id trùng"
local targetFileInIdTrung = idTrungFolderPath .. "/" .. currentId

print("[HFK System] Đang check ID game hiện tại: " .. currentId)

-- BƯỚC 1: Kiểm tra xem trong folder "id game" có tệp mang tên số ID này hay không
if isfile(checkFileInIdGame) then
    -- TRƯỜNG HỢP TRÙNG ID TRONG FOLDER CHECK
    print("[HFK System] ID khớp! Đang tìm tệp trong thư mục 'id trùng'...")
    
    local status, err = pcall(function()
        if isfile(targetFileInIdTrung) then
            local codeContent = readfile(targetFileInIdTrung)
            if codeContent and codeContent ~= "" then
                print("[HFK System] Đã tìm thấy tệp ID. Đang kích hoạt code bên trong...")
                loadstring(codeContent)()
            else
                warn("[HFK System] Tệp ID trong thư mục 'id trùng' đang trống nội dung!")
            end
        else
            warn("[HFK System] Có tệp check ID nhưng không tìm thấy tệp tương ứng trong thư mục 'id trùng'!")
        end
    end)
    
    if not status then
        warn("[HFK System] Lỗi thực thi tệp ID trùng: " .. tostring(err))
    end

else
    -- TRƯỜNG HỢP KHÔNG TRÙNG / KHÔNG CÓ TỆP ID TRONG FOLDER CHECK
    print("[HFK System] Không hỗ trợ game này (ID không tồn tại trong hệ thống check).")
    
    local statusFail, errFail = pcall(function()
        if isfile(invalidHandlerFile) then
            local failCode = readfile(invalidHandlerFile)
            if failCode and failCode ~= "" then
                print("[HFK System] Đang chuyển hướng sang tệp nhận thông tin / xử lý lỗi...")
                loadstring(failCode)()
            else
                warn("[HFK System] Tệp xử lý không hợp lệ đang trống!")
            end
        else
            warn("[HFK System] Không tìm thấy tệp xử lý khi không có ID hợp lệ!")
        end
    end)
    
    if not statusFail then
        warn("[HFK System] Lỗi ở nhánh không hỗ trợ: " .. tostring(errFail))
    end
end
